{
  "manifest_version": 3,
  "name": "Satyam LeetCode Auto Sync",
  "version": "1.0.0",
  "description": "Automatically sync accepted LeetCode submissions to GitHub.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://127.0.0.1:8763/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page.js"
      ],
      "matches": [
        "https://leetcode.com/*"
      ]
    }
  ]
}